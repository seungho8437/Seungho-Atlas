{
  "schemaVersion": 1,
  "sourceId": "WHO_ACUPOINT_2008",
  "title": "WHO proportional bone and finger-cun calibration registry",
  "principle": "B-cun is calibrated from region-specific landmark intervals; never from a single global body-height scale. F-cun remains a separate finger-based unit.",
