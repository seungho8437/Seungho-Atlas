  "acceptancePolicy": {
    "acceptedAnchorRequiredFields": [
      "landmarkId",
      "modelRevision",
      "method",
      "position",
      "surfaceProjection",
      "reviewStatus",
      "evidence",
      "provenance"
    ],
    "reviewStatusToUseAsCalibration": [
      "accepted"
    ],
    "detectorOnlyMayNotCalibrate": true,
    "positionTolerance": {
      "surfaceDistanceMaxModelUnits": 0.01,
      "pairedLateralityMustMatch": true,
      "pairedSymmetryIsSupportingOnly": true
    }
  }
