{
  "schemaVersion": 1,
  "title": "Specialized detector and manual-anchor specification for unresolved acupoint calibration landmarks",
  "principles": [
    "No unresolved landmark receives a coordinate by generic anthropometric ratio alone.",
    "Detector proposals and accepted landmark anchors are separate objects.",
    "Manual anchors must lie on the body-surface mesh and carry explicit provenance and reviewer status.",
    "Detector-derived anchors are not accepted automatically unless landmark-specific QC passes.",
    "Bilateral landmarks require laterality checks and paired plausibility checks, but symmetry never overrides source anatomy.",
    "All accepted anchors are tied to the exact atlas/model revision."
  ],
  "statuses": {
    "detector": [
      "not-applicable",
      "candidate-only",
      "requires-manual-confirmation",
      "validated-for-this-model"
    ],
    "anchor": [
      "missing",
      "proposed",
      "reviewed",
      "accepted",
      "rejected"
    ]
  },
  "landmarks": [
    {
      "landmarkId": "midpoint-anterior-hairline",
      "class": "soft-surface-boundary",
      "primaryMethod": "manual-anchor",
      "detector": {
        "type": "surface-boundary-detector",
        "status": "candidate-only",
        "requiredSignals": [
          "hair-bearing/non-hair-bearing boundary or explicit texture/segmentation input"
        ],
        "forbiddenFallbacks": [
          "fixed fraction of cranial height",
          "fixed distance from glabella without source landmark confirmation"
        ],
        "output": "candidate polyline on anterior scalp surface"
      },
      "manualAnchor": {
        "geometryType": "point-on-surface",
        "definition": "midpoint of the anterior hairline on the midsagittal plane",
        "constraints": [
          "midsagittal",
          "anterior-scalp",
          "on-surface"
        ],
        "requiredEvidence": [
          "orthogonal front view",
          "orthogonal lateral view",
          "visible or externally supplied hairline boundary"
        ]
      }
    },
